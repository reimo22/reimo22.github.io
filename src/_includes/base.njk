{% import "icon-link.njk" as icons %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
    <link rel="stylesheet" href="/assets/css/main.css" />
    <!-- Must stay inline and blocking: a deferred or external script paints the
         wrong theme first and then corrects it, which is a visible flash. The
         .js class is what reveals JS-only affordances (theme toggle), so they
         never render as dead controls without JS. -->
    <script>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            root.setAttribute("data-theme", stored);
          }
        } catch {
          /* private mode / storage disabled: falls back to the dark default */
        }
      })();
    </script>
    <script src="/assets/js/theme.js" defer></script>
    <script src="/assets/js/codecopy.js" defer></script>
    <script type="application/json" id="site-commands">
      {{ { nav: site.nav, actions: site.actions } | dump | safe }}
    </script>
    <script src="/assets/js/commands.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <div class="header-bar">
        <nav aria-label="Primary">
          <ul>
            {% for item in site.nav %}
              <li><a href="{{ item.url }}">{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </nav>
        <!-- Hidden unless html.js — theme.js narrows the label to the theme it
             would switch to; this generic one is correct in either state. -->
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="Toggle color theme"
        >
          <img
            class="icon icon-dark"
            src="/assets/img/icons/sun.png"
            alt=""
            width="20"
            height="20"
          />
          <img
            class="icon icon-light"
            src="/assets/img/icons/moon.png"
            alt=""
            width="20"
            height="20"
          />
        </button>
      </div>
      {% block banner %}{% endblock %}
    </header>
    <main id="main"{% if resume %} class="resume-main"{% endif %}>
      {% block content %}{% endblock %}
    </main>
    <footer>
      <p class="footer-contact">
        &copy; {{ currentYear }} {{ site.title }} ·
        {{ icons.iconLink("mailto:kpinlac@keemail.me", "email", "Email") }}
        {{ icons.iconLink("https://github.com/reimo22", "github", "GitHub") }}
      </p>
      <p class="palette-hint">press / for commands · ? for help</p>
    </footer>
  </body>
</html>
