{% extends "base.njk" %}
{% block banner %}
  <div class="banner">
    <div class="banner-light" aria-hidden="true">
      <div class="banner-ground">
        <!-- Cactus ASCII art credited to "Blac...@wsb.freinet.de" -->
        <pre class="cactus">{% cactusStrip %}</pre>
      </div>
      <pre class="dino">{% ascii "dino" %}</pre>
    </div>
    <div class="banner-dark" aria-hidden="true">
      <div class="banner-sky">
        <pre class="stargap">{% starField %}</pre>
        <!-- Moon ASCII derived from a NASA/JPL/USGS Galileo spacecraft photo
             (public domain), Dec 7 1992:
             https://upload.wikimedia.org/wikipedia/commons/b/b3/Full_moon.jpeg -->
        <pre class="moon">{% moonAboveHorizon %}</pre>
      </div>
      <div class="banner-ground">
        <!-- Cactus ASCII art credited to "Blac...@wsb.freinet.de" -->
        <pre class="cactus">{% cactusStrip %}</pre>
      </div>
      <pre class="dino">{% ascii "dino" %}</pre>
      <span class="shooting-star">✦</span>
      <span class="shooting-star">✦</span>
      <span class="shooting-star">✦</span>
      <span class="shooting-star">✦</span>
    </div>
  </div>
{% endblock %}
{% block content %}
  <h1>{{ site.title }}<span class="cursor" aria-hidden="true">_</span></h1>
  <p>Portfolio, HTB writeups, and build log.</p>
{% endblock %}
